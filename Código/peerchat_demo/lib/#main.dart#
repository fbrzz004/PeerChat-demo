                child: Text(
                  'Comunidades',
                  style: TextStyle(
                    color: !isPersonasSelected ? Colors.black : Colors.grey,
                    fontWeight: !isPersonasSelected
                        ? FontWeight.bold
                        : FontWeight.normal,
                  ),
                ),
              ),
            ],
          ),
        ),
      ],
    );
