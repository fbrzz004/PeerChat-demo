}

class ProfilePage extends StatelessWidget {
  final String username = 'TuNombreUsuario';
  final String bio = 'Esta es una breve descripción sobre ti.';

  // Función para generar un color aleatorio
  Color getRandomColor() {
    Random random = Random();
    return Color.fromARGB(
      255,
      random.nextInt(256),
      random.nextInt(256),
      random.nextInt(256),
    );
  }

  // Lista de emojis para el estado de ánimo
  final List<String> moodEmojis = ['😀', '😢', '😠', '😴', '🤢', '😍', '😎'];

  // Datos de ejemplo para el gráfico de emociones
  final List<FlSpot> moodData = [
    FlSpot(0, 3),
    FlSpot(1, 4),
    FlSpot(2, 2),
    FlSpot(3, 5),
    FlSpot(4, 3),
    FlSpot(5, 4),
    FlSpot(6, 2),
  ];

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      child: Column(
        children: [
          SizedBox(height: 20),
          // Foto de perfil centrada
          Center(
            child: CircleAvatar(
              radius: 50,
              backgroundColor: getRandomColor(),
              child: Text(
                username[0],
                style: TextStyle(color: Colors.white, fontSize: 40),
              ),
            ),
          ),
          SizedBox(height: 10),
          // Nombre de usuario centrado
          Center(
            child: Text(
              username,
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            ),
          ),
          SizedBox(height: 10),
          // Biografía centrada
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 20.0),
            child: Text(
              bio,
              textAlign: TextAlign.center,
              style: TextStyle(fontSize: 16),
            ),
          ),
          SizedBox(height: 20),
          // "¿Cómo te sientes hoy?"
          Text(
            '¿Cómo te sientes hoy?',
            style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 10),
          // Lista horizontal de emojis
          Container(
            height: 50,
            child: ListView.builder(
              scrollDirection: Axis.horizontal,
              itemCount: moodEmojis.length,
              itemBuilder: (context, index) {
                return GestureDetector(
                  onTap: () {
                    // Acción al seleccionar un emoji
                  },
                  child: Container(
                    width: 50,
                    margin: EdgeInsets.symmetric(horizontal: 5),
                    child: Center(
                      child: Text(
                        moodEmojis[index],
                        style: TextStyle(fontSize: 30),
                      ),
                    ),
                  ),
                );
              },
            ),
          ),
          SizedBox(height: 20),
          // "Así estuvo tu ánimo estos días:"
          Text(
            'Así estuvo tu ánimo estos días:',
            style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 20),
          // Gráfico lineal de emociones con ejes X e Y y colores en el eje Y
          Container(
            height: 300, // Aumenta la altura para mejor visualización
            padding: EdgeInsets.symmetric(horizontal: 20),
            child: LineChart(
              LineChartData(
                lineTouchData: LineTouchData(enabled: false),
                gridData: FlGridData(
                  show: true,
                  drawVerticalLine: true,
                  drawHorizontalLine: true,
                  getDrawingHorizontalLine: (value) => FlLine(
                    color: Colors.grey.withOpacity(0.3),
                    strokeWidth: 1,
                  ),
                  getDrawingVerticalLine: (value) => FlLine(
                    color: Colors.grey.withOpacity(0.3),
                    strokeWidth: 1,
                  ),
                ),
                titlesData: FlTitlesData(
                  show: true,
                  bottomTitles: AxisTitles(
                    sideTitles: SideTitles(
                      showTitles: true,
                      reservedSize: 30,
                      interval: 1,
                      getTitlesWidget: (value, meta) {
                        // Define etiquetas para el eje X
                        List<String> days = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
                        String label = '';
                        if (value.toInt() >= 0 && value.toInt() < days.length) {
                          label = days[value.toInt()];
                        }
                        return Text(
                          label,
                          style: TextStyle(
                            color: Colors.black,
                            fontSize: 10,
                          ),
                        );
                      },
                    ),
                  ),
                  leftTitles: AxisTitles(
                    sideTitles: SideTitles(
                      showTitles: true,
                      reservedSize: 40,
                      interval: 1,
                      getTitlesWidget: (value, meta) {
                        return Text(
                          value.toInt().toString(),
                          style: TextStyle(
                            color: Colors.black,
                            fontSize: 10,
                          ),
                        );
                      },
                    ),
                  ),
                  topTitles: AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  rightTitles: AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                ),
                borderData: FlBorderData(
                  show: true,
                  border: Border.all(color: Colors.grey),
                ),
                minX: 0,
                maxX: 6,
                minY: 0,
                maxY: 5,
                rangeAnnotations: RangeAnnotations(
                  verticalRangeAnnotations: [],
                  horizontalRangeAnnotations: [
                    HorizontalRangeAnnotation(
                      y1: 0,
                      y2: 1,
                      color: Colors.red.withOpacity(0.1),
                    ),
                    HorizontalRangeAnnotation(
                      y1: 1,
                      y2: 2,
                      color: Colors.blue.withOpacity(0.1),
                    ),
                    HorizontalRangeAnnotation(
                      y1: 2,
                      y2: 3,
                      color: Colors.green.withOpacity(0.1),
                    ),
                    HorizontalRangeAnnotation(
                      y1: 3,
                      y2: 4,
                      color: Colors.orange.withOpacity(0.1),
                    ),
                    HorizontalRangeAnnotation(
                      y1: 4,
                      y2: 5,
                      color: Colors.yellow.withOpacity(0.1),
                    ),
                  ],
                ),
                lineBarsData: [
                  LineChartBarData(
                    spots: moodData,
                    isCurved: true,
                    barWidth: 3,
                    color: Colors.blue,
                    dotData: FlDotData(show: true),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}
