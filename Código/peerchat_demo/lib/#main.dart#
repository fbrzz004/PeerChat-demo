        ),
        // Selector entre "Personas" y "Comunidades" (movido abajo)
        Container(
          color: Colors.white,
          padding: EdgeInsets.symmetric(vertical: 10),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              // Botón "Personas"
              TextButton(
                onPressed: () {
