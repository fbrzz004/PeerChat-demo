class HomeScreen extends StatefulWidget {
  @override
  _HomeScreenState createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;

  // Lista de páginas para la navegación inferior
  final List<Widget> _pages = [
    ChatsPage(),
    CommunityPage(),
    ProfilePage(),
  ];

  // Método para actualizar el índice seleccionado
  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
    });
  }

  // AppBar personalizado
  PreferredSizeWidget _buildAppBar() {
    return AppBar(
      backgroundColor: Colors.white, // Fondo blanco
      elevation: 0, // Sin sombra
      leading: IconButton(
        icon: Icon(Icons.menu, color: Colors.black),
        onPressed: () {
          // Acción al presionar el icono de menú
        },
      ),
      title: TextField(
        decoration: InputDecoration(
          hintText: 'Buscar',
          border: InputBorder.none,
          prefixIcon: Icon(Icons.search, color: Colors.grey),
        ),
      ),
    );
  }

  Color _getSelectedItemColor(int index) {
    switch (index) {
      case 0:
        return Colors.purple; // Chats - Morado
      case 1:
        return Colors.orange; // Comunidad - Naranja
      case 2:
        return Colors.green; // Perfil - Verde
      default:
        return Colors.blue;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: _buildAppBar(),
      body: _pages[_selectedIndex],
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _selectedIndex,
        onTap: _onItemTapped,
        selectedItemColor: _getSelectedItemColor(_selectedIndex),
        unselectedItemColor: Colors.grey,
        items: [
          BottomNavigationBarItem(
            icon: Icon(Icons.chat_bubble_outline),
            label: '', // Sin etiqueta
          ),
          BottomNavigationBarItem(
            icon: Icon(Icons.group_outlined),
            label: '', // Sin etiqueta
          ),
          BottomNavigationBarItem(
            icon: Icon(Icons.person_outline),
            label: '', // Sin etiqueta
          ),
        ],
      ),
    );
  }
}

