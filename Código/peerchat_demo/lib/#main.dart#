    'Amante de la tecnología',
    'Aficionado al deporte',
    'Músico en formación',
    'Viajero del mundo',
    'Cocinero aficionado',
  ];

  final List<String> emojis = ['😀', '🎉', '🚀', '🌟', '🔥'];

  // Datos para "Comunidades"
  final List<String> nombresComunidades = [
    'Grupo de Música',
    'Amantes del Fútbol',
    'Viajeros',
    'Programadores',
    'Cocina y Recetas',
  ];

  final List<String> descripcionesComunidades = [
    'Compartimos y descubrimos música nueva.',
