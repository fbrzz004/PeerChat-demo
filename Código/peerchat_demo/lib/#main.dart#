  Widget build(BuildContext context) {
    return Column(
      children: [
        // Opciones superiores
        Container(
          color: Colors.white,
          padding: EdgeInsets.symmetric(vertical: 10),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              // Botón izquierdo (varía según la selección)
              TextButton(
                onPressed: () {
                  // Acción según la selección
