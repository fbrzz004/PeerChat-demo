          ),
        ),
        // Contenido principal
        Expanded(
          child: ListView.builder(
            itemCount: isPersonasSelected
                ? nombresPersonas.length
                : nombresComunidades.length,
            itemBuilder: (context, index) {
              if (isPersonasSelected) {
                // Mostrar personas
                return Card(
                  margin: EdgeInsets.all(10),
