              ),
              SizedBox(width: 20),
              // Botón derecho (varía según la selección)
              TextButton(
                onPressed: () {
                  // Acción según la selección
                },
                child: Text(
                  isPersonasSelected ? 'Ayudar' : 'Tus comunidades',
